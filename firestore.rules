rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function profile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function signedInWithActiveProfile() {
      return request.auth != null && profile().activo == true;
    }

    function hasRole(roles) {
      return signedInWithActiveProfile() && profile().rol in roles;
    }

    function isAdministrator() {
      return hasRole(['Administrador']);
    }

    function isSupervisor() {
      return hasRole(['Administrador', 'Coordinador']);
    }

    function isOperationalUser() {
      return hasRole(['Administrador', 'Coordinador', 'Funcionario']);
    }

    // Mirrors canReadAllExpedients in src/lib/permissions.ts. Everyone else (the
    // Funcionario) only sees the expedients they registered, held or acted on.
    function canReadAll() {
      return hasRole(['Administrador', 'Coordinador', 'Directivo', 'Consulta']);
    }

    function isParticipant(expedient) {
      return request.auth.uid in expedient.get('participantes', []);
    }

    function canReadExpedient(expedient) {
      return canReadAll() || (signedInWithActiveProfile() && isParticipant(expedient));
    }

    // Mirrors DEPENDENCIES in src/lib/dependencies.ts.
    function isDependency(value) {
      return value in ['catastro', 'cobro-coactivo', 'impuestos', 'fiscalizacion',
        'contabilidad', 'tesoreria', 'presupuesto'];
    }

    // Mirrors CORRESPONDENCE_CLASSES in src/lib/correspondence.ts; absent means Externa.
    function isCorrespondenceClass(data) {
      return data.get('clase', 'Externa') in ['Externa', 'Interna'];
    }

    function expedientPath(expedientId) {
      return /databases/$(database)/documents/expedientes/$(expedientId);
    }

    function entryFilingPath(number) {
      return /databases/$(database)/documents/radicadosEntrada/$(number);
    }

    // Mirrors canManageExpedient in src/lib/permissions.ts; keep both in sync.
    // A Funcionario handles the active expedients assigned to them, or the ones they
    // registered while nobody holds them; finalized expedients are for supervisors.
    function canManageExpedient(expedient) {
      return expedient.get('activo', false) == true
        ? isSupervisor() ||
          (isOperationalUser() &&
            (expedient.get('funcionarioAsignado', null) == null
              ? expedient.get('creadoPor', '') == request.auth.uid
              : expedient.funcionarioAsignado.uid == request.auth.uid))
        : isSupervisor();
    }

    // Whoever writes and the assignee must be in participantes after the write.
    function hasValidParticipants(data) {
      return data.get('participantes', null) is list &&
        request.auth.uid in data.participantes &&
        (data.get('funcionarioAsignado', null) == null ||
          data.funcionarioAsignado.uid in data.participantes);
    }

    // The entry filing number is unique: the batch must claim radicadosEntrada/{number}.
    function claimsEntryFiling(expedientId, number) {
      return existsAfter(entryFilingPath(number)) &&
        getAfter(entryFilingPath(number)).data.expedienteId == expedientId;
    }

    // Mirrors NOTE_ACTION, MIN_NOTE_LENGTH and MAX_NOTE_LENGTH in src/lib/expedient-notes.ts.
    // Only the note itself is written: the expedient stays untouched.
    function isValidNote(expedientId) {
      return request.resource.data.keys().hasOnly(['usuario', 'accion', 'detalle', 'fecha']) &&
        request.resource.data.accion == 'Nota' &&
        request.resource.data.detalle is string &&
        request.resource.data.detalle.size() >= 5 &&
        request.resource.data.detalle.size() <= 1000 &&
        request.resource.data.fecha == request.time &&
        exists(expedientPath(expedientId)) &&
        canReadExpedient(get(expedientPath(expedientId)).data);
    }

    // Mirrors the limits in src/lib/expedient-transfer.ts: closed here as Transferido,
    // with where it went and why.
    function isValidTransfer(data) {
      return data.estado == 'Transferido' &&
        data.activo == false &&
        data.get('transferencia', null) is map &&
        data.transferencia.get('destino', null) is string &&
        data.transferencia.destino.size() >= 3 &&
        data.transferencia.destino.size() <= 120 &&
        data.transferencia.get('motivo', null) is string &&
        data.transferencia.motivo.size() >= 5 &&
        data.transferencia.motivo.size() <= 1000;
    }

    // Closing an expedient through the workflow, or transferring it to another
    // dependency, is part of the Funcionario's job; archiving it outside the workflow
    // is reserved for supervisors.
    function isAllowedActivoChange() {
      return request.resource.data.activo == resource.data.activo ||
        isAdministrator() ||
        (request.resource.data.activo == false &&
          (isSupervisor() || request.resource.data.estado == 'Archivo (Finalizado)' ||
            isValidTransfer(request.resource.data)));
    }

    match /usuarios/{userId} {
      allow get: if signedInWithActiveProfile() &&
        (request.auth.uid == userId || isAdministrator());
      // Everyone else reads directorioUsuarios, which omits email and job details.
      allow list: if isAdministrator();
      allow create, delete: if isAdministrator();
      allow update: if isAdministrator() ||
        (signedInWithActiveProfile() && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ultimoIngreso']));
    }

    // Minimal copy of each profile (uid, name, role, active, area) used to pick and
    // filter assignees. Administrators write it in the same batch as the full profile.
    match /directorioUsuarios/{userId} {
      allow get, list: if signedInWithActiveProfile();
      allow create, update: if isAdministrator() &&
        request.resource.data.keys().hasOnly(['uid', 'nombreCompleto', 'rol', 'activo', 'dependencia']) &&
        request.resource.data.uid == userId;
      allow delete: if isAdministrator();
    }

    match /expedientes/{expedientId} {
      // Queries must ask exactly for what the reader may see: a Funcionario filters
      // with where('participantes', 'array-contains', uid).
      allow get, list: if canReadExpedient(resource.data);
      allow create: if isOperationalUser() &&
        request.resource.data.id == expedientId &&
        request.resource.data.creadoPor == request.auth.uid &&
        request.resource.data.activo == true &&
        request.resource.data.estado == 'Recibido' &&
        request.resource.data.numeroRadicado is string &&
        request.resource.data.numeroRadicado.size() > 0 &&
        isDependency(request.resource.data.get('dependencia', '')) &&
        isCorrespondenceClass(request.resource.data) &&
        // The transfer trail is written only when closing as Transferido.
        !request.resource.data.keys().hasAny(['transferencia']) &&
        // Each person registers in their own area; supervisors choose it.
        (isSupervisor() ||
          request.resource.data.dependencia == profile().get('dependencia', 'catastro')) &&
        hasValidParticipants(request.resource.data) &&
        claimsEntryFiling(expedientId, request.resource.data.numeroRadicado);
      // ultimaAlertaVencimiento is written only by Apps Script, which uses IAM
      // credentials and is therefore not subject to these rules.
      allow update: if canManageExpedient(resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['id', 'creadoPor', 'fechaCreacion', 'ultimaAlertaVencimiento']) &&
        // The entry filing number identifies the expedient, its class decides the number's
        // format and the area decides who works on it; only supervisors change them.
        (isSupervisor() ||
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['numeroRadicado', 'dependencia'])) &&
        // Expedients from before the class have no field: writing 'Externa' keeps it.
        (isSupervisor() ||
          request.resource.data.get('clase', 'Externa') == resource.data.get('clase', 'Externa')) &&
        isDependency(request.resource.data.get('dependencia', 'catastro')) &&
        isCorrespondenceClass(request.resource.data) &&
        // participantes only grows: nobody loses access to what passed through them.
        request.resource.data.participantes.hasAll(resource.data.get('participantes', [])) &&
        hasValidParticipants(request.resource.data) &&
        (request.resource.data.numeroRadicado == resource.data.numeroRadicado ||
          claimsEntryFiling(expedientId, request.resource.data.numeroRadicado)) &&
        // Closing as Transferido always carries a valid transfer, written once; only an
        // Administrator corrects it afterwards.
        (request.resource.data.estado != 'Transferido' ||
          resource.data.estado == 'Transferido' ||
          isValidTransfer(request.resource.data)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['transferencia']) ||
          isAdministrator() ||
          (resource.data.get('transferencia', null) == null &&
            isValidTransfer(request.resource.data))) &&
        isAllowedActivoChange();
      allow delete: if false;

      match /historial/{historyId} {
        allow get, list: if canReadExpedient(get(expedientPath(expedientId)).data);
        // Only whoever may act on the expedient (before this batch) writes its history;
        // a new expedient's history is written by whoever registers it.
        // A note (src/lib/expedient-notes.ts) is the exception: whoever reads the expedient
        // and is an operational user may add one, even if they no longer act on it.
        allow create: if isOperationalUser() &&
          request.resource.data.usuario == request.auth.uid &&
          ((existsAfter(expedientPath(expedientId)) &&
            (exists(expedientPath(expedientId))
              ? canManageExpedient(get(expedientPath(expedientId)).data)
              : getAfter(expedientPath(expedientId)).data.creadoPor == request.auth.uid)) ||
           isValidNote(expedientId));
        allow update, delete: if false;
      }
    }

    // Index that makes the entry filing number unique across all expedients, which a
    // Funcionario cannot query. Only the expedient id is stored.
    match /radicadosEntrada/{number} {
      allow get: if signedInWithActiveProfile();
      allow list: if false;
      allow create: if isOperationalUser() &&
        request.resource.data.keys().hasOnly(['expedienteId']) &&
        getAfter(expedientPath(request.resource.data.expedienteId)).data.numeroRadicado == number;
      // Correcting an entry filing number releases the old one.
      allow delete: if isSupervisor();
      allow update: if false;
    }

    match /tiposTramite/{typeId} {
      allow get, list: if signedInWithActiveProfile();
      allow create, update: if isAdministrator();
      allow delete: if false;
    }

    match /configuracion/{configurationId} {
      allow get, list: if signedInWithActiveProfile();
      allow create, update: if isAdministrator();
      allow delete: if false;
    }

    // A filing is visible to whoever can see its expedient. A Funcionario queries them
    // by expedienteId (== or in, at most 10 per query).
    match /radicados/{filingId} {
      allow get, list: if canReadAll() ||
        (signedInWithActiveProfile() &&
          isParticipant(get(expedientPath(resource.data.expedienteId)).data));
      allow create: if isOperationalUser() &&
        request.resource.data.expedienteId is string &&
        existsAfter(expedientPath(request.resource.data.expedienteId)) &&
        canManageExpedient(get(expedientPath(request.resource.data.expedienteId)).data);
      // Supervisors correct the date in place; a corrected number is a new document
      // (its id includes the number) plus the deletion of the old one. When the entry
      // filing number of the expedient changes, its copy here follows it.
      allow update: if isSupervisor() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fecha', 'editadoPor', 'fechaEdicion', 'expedienteRadicado']) &&
        (request.resource.data.get('expedienteRadicado', null) ==
            resource.data.get('expedienteRadicado', null) ||
          request.resource.data.expedienteRadicado ==
            getAfter(expedientPath(resource.data.expedienteId)).data.numeroRadicado);
      allow delete: if isSupervisor();
    }

    match /solicitudesPruebaCorreo/{requestId} {
      allow get, list: if isAdministrator();
      allow create: if isAdministrator();
      allow update, delete: if false;
    }

    // Only identifiers are stored: Apps Script reads the recipient's address and
    // the message content from Firestore, so a client cannot choose either. The
    // recipient must be the expedient's assignee once the batch is applied.
    match /notificacionesAsignacion/{notificationId} {
      allow create: if isOperationalUser() &&
        request.resource.data.keys().hasOnly(
          ['expedienteId', 'destinatarioUid', 'solicitadoPor', 'estado', 'fechaSolicitud']) &&
        request.resource.data.solicitadoPor == request.auth.uid &&
        request.resource.data.estado == 'Pendiente' &&
        request.resource.data.fechaSolicitud == request.time &&
        getAfter(expedientPath(request.resource.data.expedienteId))
          .data.funcionarioAsignado.uid == request.resource.data.destinatarioUid;
      allow get, list, update, delete: if false;
    }

    // Questions from management (Directivo, and supervisors) to an expedient's assignee.
    // Only identifiers and the question are stored; Apps Script reads the recipient's
    // address from Firestore and sends the email, so a client cannot choose it.
    // Mirrors canAskAboutExpedients in src/lib/permissions.ts.
    match /consultasDireccion/{inquiryId} {
      allow create: if hasRole(['Administrador', 'Coordinador', 'Directivo']) &&
        request.resource.data.keys().hasOnly(['expedienteId', 'expedienteRadicado',
          'destinatarioUid', 'destinatarioNombre', 'solicitadoPor', 'pregunta', 'estado',
          'fechaSolicitud']) &&
        request.resource.data.solicitadoPor == request.auth.uid &&
        request.resource.data.estado == 'Pendiente' &&
        request.resource.data.fechaSolicitud == request.time &&
        request.resource.data.pregunta is string &&
        request.resource.data.pregunta.size() >= 5 &&
        request.resource.data.pregunta.size() <= 1000 &&
        get(expedientPath(request.resource.data.expedienteId))
          .data.funcionarioAsignado.uid == request.resource.data.destinatarioUid;
      allow get, list: if signedInWithActiveProfile() &&
        resource.data.solicitadoPor == request.auth.uid;
      allow update, delete: if false;
    }

    // Recordatorios (src/lib/reminders.ts): uno por destinatario. Cada quien se los crea a sí
    // mismo; Administrador y Coordinador también a otros. Apps Script envía el correo del día
    // con credenciales IAM, sin pasar por estas reglas.
    match /recordatorios/{reminderId} {
      allow get, list: if signedInWithActiveProfile() &&
        (resource.data.destinatarioUid == request.auth.uid ||
          resource.data.creadoPor == request.auth.uid || isSupervisor());
      allow create: if signedInWithActiveProfile() &&
        request.resource.data.keys().hasOnly(['id', 'grupo', 'titulo', 'descripcion', 'fecha',
          'destinatarioUid', 'destinatarioNombre', 'creadoPor', 'creadoPorNombre', 'documentos',
          'correo', 'correoAviso', 'hecho', 'fechaCreacion']) &&
        request.resource.data.id == reminderId &&
        request.resource.data.creadoPor == request.auth.uid &&
        (request.resource.data.destinatarioUid == request.auth.uid || isSupervisor()) &&
        exists(/databases/$(database)/documents/directorioUsuarios/$(request.resource.data.destinatarioUid)) &&
        request.resource.data.correo == 'Pendiente' &&
        request.resource.data.get('correoAviso', 'Pendiente') == 'Pendiente' &&
        request.resource.data.hecho == false &&
        request.resource.data.fechaCreacion == request.time &&
        request.resource.data.titulo is string &&
        request.resource.data.titulo.size() >= 3 &&
        request.resource.data.titulo.size() <= 120 &&
        request.resource.data.get('descripcion', '') is string &&
        request.resource.data.get('descripcion', '').size() <= 1000 &&
        request.resource.data.fecha is string &&
        request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.documentos is list &&
        request.resource.data.documentos.size() <= 5;
      // Quien lo recibe solo lo marca como hecho o lo reabre.
      allow update: if signedInWithActiveProfile() &&
        resource.data.destinatarioUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hecho', 'fechaHecho']) &&
        request.resource.data.hecho is bool;
      allow delete: if signedInWithActiveProfile() &&
        (resource.data.creadoPor == request.auth.uid || isAdministrator());
    }

    match /tareas/{taskId} {
      allow get: if signedInWithActiveProfile() && resource.data.responsableId == request.auth.uid;
      allow list: if signedInWithActiveProfile() && resource.data.responsableId == request.auth.uid;
      allow create: if signedInWithActiveProfile() &&
        request.resource.data.responsableId == request.auth.uid;
      allow update: if signedInWithActiveProfile() &&
        resource.data.responsableId == request.auth.uid &&
        request.resource.data.responsableId == resource.data.responsableId;
      allow delete: if signedInWithActiveProfile() && resource.data.responsableId == request.auth.uid;
    }
  }
}
